# Resend — used by /api/contact to email contact-form submissions to the business inbox.
# Create a free account at https://resend.com and generate an API key.
RESEND_API_KEY=

# Optional overrides for the contact form email (defaults shown below).
# For production deliverability, verify a sending domain in Resend and set
# CONTACT_FROM_EMAIL to use that domain.
# CONTACT_FROM_EMAIL="Mirdita Webseite <onboarding@resend.dev>"
# CONTACT_TO_EMAIL=info@mirdita.ch

# Optional — Google Places API for live reviews on the homepage.
# Falls back to curated reviews if either value is missing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional — Microsoft Clarity project ID for heatmaps & session recordings.
# Create a free project at https://clarity.microsoft.com and copy its ID.
# Leave empty to disable Clarity entirely.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional — Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Create a GA4 property at https://analytics.google.com, then copy the
# measurement ID from Admin → Data streams → your web stream.
# Leave empty to disable Google Analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
